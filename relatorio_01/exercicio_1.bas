Dim peso As Double
Dim qtdagua As Integer
Dim metadiaria As Double
Dim aguaconta As Integer = 35

Input peso
Input qtdagua

metadiaria = peso * aguaconta

if qtdagua >= metadiaria Then
    Print "Meta atingida!"
else
    Print "Meta não atingida"
End if 
Sleep

